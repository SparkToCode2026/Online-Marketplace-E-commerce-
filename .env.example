# Copy this file to .env and fill in every value (.env is gitignored — never commit it).
# Avoid ; and = in passwords (they break the connection string).

# --- Docker Hub ---
# Your Docker Hub username; images are pushed as <user>/marketplace-api and <user>/marketplace-web
DOCKERHUB_USER=your-dockerhub-username
# Version tag to build/push/run (e.g. v1.0.0). Bump it for every release.
IMAGE_TAG=latest

# --- Secrets ---
# SQL Server SA password: 8+ chars with upper, lower and a digit.
MSSQL_SA_PASSWORD=ChangeMe_Str0ngPassw0rd
# JWT signing key: 32+ random characters.
JWT_KEY=change-this-to-a-long-random-string-32-chars-min
# Password given to the seeded demo accounts (including the Admin) on the first run.
SEED_PASSWORD=ChangeMe_Seed_Passw0rd
# Shared secret between the API and the WhatsApp bot: 32+ random characters (openssl rand -hex 32).
# Leave it empty to switch the bot endpoints off.
BOT_KEY=

# --- HTTPS ---
# Domain Caddy gets the certificate for (on the server). Must point to the server's IP first.
# Locally just leave it as localhost — Caddy doesn't run there.
DOMAIN=localhost

# --- Optional ---
# Local-only: host port for http://localhost (on the server Caddy uses 80/443).
WEB_PORT=80
# Gmail address + App Password to actually send order/shipping emails (leave empty to disable).
SMTP_USERNAME=
SMTP_PASSWORD=

# --- WhatsApp bot (also needs BOT_KEY above) ---
# Meta dashboard > WhatsApp > API Setup: the access token and the "Phone Number ID"
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# platform.openai.com > API keys
OPENAI_API_KEY=
# Optional: WhatsApp number (e.g. 968xxxxxxxx) that gets the daily tech digest at 8:00,
# and a short English description of them (skills, projects) so the news fit them
DIGEST_TO=
DIGEST_PROFILE=

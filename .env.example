# Copy this file to .env and change both values (.env is gitignored).
# SQL Server needs a strong SA password: 8+ chars with upper, lower and a digit.
# Avoid ; and = in it (they break the connection string).
MSSQL_SA_PASSWORD=ChangeMe_Str0ngPassw0rd
# JWT signing key: 32+ random characters.
JWT_KEY=change-this-to-a-long-random-string-32-chars-min

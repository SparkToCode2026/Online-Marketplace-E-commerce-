# Copy this file to ".env" and fill in the values (for running the bot locally with "python app.py").
# Never commit .env: it holds your secret tokens.

# Meta dashboard > WhatsApp > API Setup > "Generate token"
WHATSAPP_TOKEN=

# Same page, "Phone Number ID"
PHONE_NUMBER_ID=

# platform.openai.com > API keys > "Create new secret key"
OPENAI_API_KEY=

# Optional: which OpenAI model answers (default: gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini

# The store API. Locally ("dotnet run") it's http://localhost:5190/api (the default).
# STORE_API_URL=http://localhost:5190/api

# Must be the same as Bot:Key in the API (BOT_KEY in the main .env)
BOT_KEY=

# Optional: the store's website, sent to customers who ask for the link
# STORE_URL=https://your-domain

# Optional: the WhatsApp number (e.g. 968xxxxxxxx) that gets the daily digest (digest.py)
# DIGEST_TO=
